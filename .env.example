# Birdeye API key — free at https://bds.birdeye.so
BIRDEYE_API_KEY=

# Helius RPC key — free at https://helius.dev — needed later for Drift execution
HELIUS_API_KEY=

# X (Twitter) API bearer token — for the sentiment module (later)
X_API_BEARER=

# Hot-wallet secret for Drift execution (base58 Solana secret key). Later.
# NEVER put your main wallet here. Generate a fresh hot wallet.
NOMAD_WALLET_SECRET=
